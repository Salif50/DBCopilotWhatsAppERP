# ============================================================
# DB Copilot WhatsApp — Environment Configuration
# AI Tinkerers — Agents Everywhere
# ============================================================
#
# IMPORTANT:
# 1. Copier ce fichier :
#       cp .env.example .env
#
# 2. Modifier les valeurs CHANGE_ME dans .env
#
# 3. Ne JAMAIS envoyer .env sur GitHub.
# ============================================================


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=n8n


# ============================================================
# N8N
# ============================================================

# Clé utilisée par n8n pour chiffrer les credentials.
# Utiliser une longue valeur aléatoire.
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Développement local
WEBHOOK_URL=http://localhost:5678/

# false pour HTTP local.
# En production HTTPS, utiliser true.
N8N_SECURE_COOKIE=false

# Fuseau horaire Guinée
GENERIC_TIMEZONE=Africa/Conakry
TZ=Africa/Conakry


# ============================================================
# GOWA — WHATSAPP GATEWAY
# ============================================================

# Format :
# username:password
GOWA_BASIC_AUTH=admin:CHANGE_ME_GOWA_PASSWORD

# Passerelle alternative facultative :
# docker compose --profile waha up -d waha
WAHA_IMAGE_TAG=latest
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=CHANGE_ME_WAHA_PASSWORD
WAHA_API_KEY=CHANGE_ME_WAHA_API_KEY
WHATSAPP_DEFAULT_ENGINE=WEBJS
WHATSAPP_HOOK_URL=http://n8n:5678/webhook/gowa-db-copilot
WHATSAPP_HOOK_EVENTS=message


# ============================================================
# OPENAI
# ============================================================
#
# RECOMMANDATION :
# La clé OpenAI est normalement stockée directement dans
# les Credentials n8n et NON dans le workflow JSON.
#
# Si tu souhaites néanmoins l'utiliser via variable
# d'environnement :
#
# OPENAI_API_KEY=sk-CHANGE_ME
#
# Ne jamais committer une vraie clé API.


# ============================================================
# PLUTO DB COPILOT V7 — COMPETITION AGENT
# ============================================================

# Recherche externe. Laisser vide désactive proprement Exa.
EXA_API_KEY=

# Conversation WhatsApp qui reçoit les alertes autonomes.
# Utiliser exactement le chat_id observé dans le webhook GOWA.
PLUTO_MANAGER_CHAT_ID=

# Identifiant de session GOWA envoyé dans le header X-Device-Id.
PLUTO_GOWA_SESSION_ID=

# Numéro WhatsApp qui reçoit les diagnostics techniques n8n.
PLUTO_ERROR_ADMIN_PHONE=

# Numéro contrôlé par l'équipe pour recevoir les actions de démonstration.
PLUTO_DEMO_ACTION_PHONE=

# Secret partagé entre n8n et le service interne de contrôle.
PLUTO_CONTROL_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_CONTROL_TOKEN

# Mémoire conversationnelle Redis, 86400 secondes = 24 heures.
PLUTO_MEMORY_TTL_SECONDS=86400

# PLUTO reste silencieux sous ce niveau de confiance proactive.
PLUTO_PROACTIVE_CONFIDENCE_MIN=75

# Extension optionnelle pour une future action HTTP contrôlée.
# La v7 actuelle utilise GOWA après un OUI explicite et journalisé.
PLUTO_ACTION_WEBHOOK_URL=

# 0.20 signifie une baisse minimale de 20 % entre deux fenêtres de 7 jours.
PLUTO_SALES_DROP_THRESHOLD=0.20


# ============================================================
# DB COPILOT — POSTGRESQL READ-ONLY
# ============================================================
#
# Ces variables sont documentaires si la credential PostgreSQL
# est configurée directement dans n8n.
#
# Depuis n8n, le host PostgreSQL est "postgres",
# PAS localhost.
# ============================================================

DB_COPILOT_DB_HOST=postgres
DB_COPILOT_DB_PORT=5432
DB_COPILOT_DB_NAME=n8n
DB_COPILOT_DB_USER=db_copilot_ro
DB_COPILOT_DB_PASSWORD=CHANGE_ME_DB_COPILOT_PASSWORD

# Credential distincte, limitée à INSERT/SELECT sur le journal PLUTO.
DB_COPILOT_AUDIT_USER=db_copilot_audit
DB_COPILOT_AUDIT_PASSWORD=CHANGE_ME_DB_COPILOT_AUDIT


# ============================================================
# NGROK — OPTIONNEL
# ============================================================
#
# Utilisé uniquement avec :
# docker compose --profile tunnel up -d
#
# Exemple de domaine :
# my-db-copilot.ngrok-free.app
# ============================================================

NGROK_AUTHTOKEN=CHANGE_ME_NGROK_TOKEN
NGROK_DOMAIN=CHANGE_ME_NGROK_DOMAIN


# ============================================================
# OPTIONNEL — FUTURES EXTENSIONS
# ============================================================

QDRANT_HOST=qdrant
QDRANT_PORT=6333

REDIS_HOST=redis
REDIS_PORT=6379
