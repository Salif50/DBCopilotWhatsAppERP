# ============================================================
# DB Copilot WhatsApp — Environment Configuration
# AI Tinkerers — Agents Everywhere
# ============================================================
#
# IMPORTANT:
# 1. Copier ce fichier :
#       cp .env.example .env
#
# 2. Modifier les valeurs CHANGE_ME dans .env
#
# 3. Ne JAMAIS envoyer .env sur GitHub.
# ============================================================


# ============================================================
# POSTGRESQL
# ============================================================

POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=n8n


# ============================================================
# N8N
# ============================================================

# Clé utilisée par n8n pour chiffrer les credentials.
# Utiliser une longue valeur aléatoire.
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Développement local
WEBHOOK_URL=http://localhost:5678/

# false pour HTTP local.
# En production HTTPS, utiliser true.
N8N_SECURE_COOKIE=false

# Fuseau horaire Guinée
GENERIC_TIMEZONE=Africa/Conakry
TZ=Africa/Conakry


# ============================================================
# GOWA — WHATSAPP GATEWAY
# ============================================================

# Format :
# username:password
GOWA_BASIC_AUTH=admin:CHANGE_ME_GOWA_PASSWORD


# ============================================================
# OPENAI
# ============================================================
#
# RECOMMANDATION :
# La clé OpenAI est normalement stockée directement dans
# les Credentials n8n et NON dans le workflow JSON.
#
# Si tu souhaites néanmoins l'utiliser via variable
# d'environnement :
#
# OPENAI_API_KEY=sk-CHANGE_ME
#
# Ne jamais committer une vraie clé API.


# ============================================================
# DB COPILOT — POSTGRESQL READ-ONLY
# ============================================================
#
# Ces variables sont documentaires si la credential PostgreSQL
# est configurée directement dans n8n.
#
# Depuis n8n, le host PostgreSQL est "postgres",
# PAS localhost.
# ============================================================

DB_COPILOT_DB_HOST=postgres
DB_COPILOT_DB_PORT=5432
DB_COPILOT_DB_NAME=n8n
DB_COPILOT_DB_USER=db_copilot_ro
DB_COPILOT_DB_PASSWORD=CHANGE_ME_DB_COPILOT_PASSWORD


# ============================================================
# NGROK — OPTIONNEL
# ============================================================
#
# Utilisé uniquement avec :
# docker compose --profile tunnel up -d
#
# Exemple de domaine :
# my-db-copilot.ngrok-free.app
# ============================================================

NGROK_AUTHTOKEN=CHANGE_ME_NGROK_TOKEN
NGROK_DOMAIN=CHANGE_ME_NGROK_DOMAIN


# ============================================================
# OPTIONNEL — FUTURES EXTENSIONS
# ============================================================

QDRANT_HOST=qdrant
QDRANT_PORT=6333

REDIS_HOST=redis
REDIS_PORT=6379